# =============================================================================
# LumiBot Options Trading System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Tradier Broker (REQUIRED)
# ---------------------------------------------------------------------------
# Get your access token and account number from Tradier dashboard:
#   https://dash.tradier.com/ (or https://dash.tradier.com/brokerage/accounts)
TRADIER_ACCESS_TOKEN=your_tradier_access_token_here
TRADIER_ACCOUNT_NUMBER=your_tradier_account_number_here
# Paper trading MUST be true for sandbox validation
TRADIER_PAPER=true

# ---------------------------------------------------------------------------
# Telegram Bot (REQUIRED)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather on Telegram:
#   1. Message @BotFather and send /newbot
#   2. Copy the token below
#   3. Message your bot, then visit:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   4. Copy your chat_id from the response
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------------------------------------------------------------------------
# LLM Provider (at least ONE required)
# ---------------------------------------------------------------------------
# DeepSeek (primary — via litellm)
# Get your API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# OpenAI (alternative — uncomment if using OpenAI)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic (alternative — uncomment if using Claude)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google Gemini (alternative — uncomment if using Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Agent Configuration (optional — defaults shown)
# ---------------------------------------------------------------------------
# Model used for research agents (macro, technical, options, bull, bear, risk)
# Uses litellm model string format: provider/model-name
# DeepSeek: deepseek/deepseek-chat
# OpenAI: openai/gpt-4.1-mini
# Anthropic: anthropic/claude-sonnet-4-20250514
# AI_TRADING_TEAM_MODEL=deepseek/deepseek-chat

# Model used for the portfolio manager (makes final trading decision)
# DeepSeek reasoning model for complex decisions:
# PORTFOLIO_MANAGER_MODEL=deepseek/deepseek-reasoner

# ---------------------------------------------------------------------------

# Which underlying symbols to trade options on
# TRADING_UNIVERSE=SPY,QQQ,IWM

# ---------------------------------------------------------------------------
# Memory & Logging (optional — defaults shown)
# ---------------------------------------------------------------------------
# Directory for agent memory SQLite database
# LUMIBOT_MEMORY_DIR=/data/memory

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Backtesting (optional — only needed for backtest mode)
# ---------------------------------------------------------------------------
# BACKTESTING_DATA_SOURCE=yahoo

# ---------------------------------------------------------------------------
# Docker-specific (set by docker-compose, don't change)
# ---------------------------------------------------------------------------
# LUMIBOT_MEMORY_DIR=/data/memory
